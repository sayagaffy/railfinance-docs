<th style="text-align: center;"><img src="/img/railfinance/anggaran/media/image236.png" style="width:3.54331in;height:1.65065in" /><br />
<img src="/img/railfinance/anggaran/media/image60.png" style="width:0.1878in;height:0.10085in" /><img src="/img/railfinance/anggaran/media/image60.png" style="width:0.14402in;height:0.1538in" /><img src="/img/railfinance/anggaran/media/image60.png" style="height:0.19051in" /></th>
